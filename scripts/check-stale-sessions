#!/bin/bash
SESSIONS_DIR="$HOME/.claude/sessions"
[ ! -d "$SESSIONS_DIR" ] && exit 0

STALE=""
NOW=$(date +%s)

for f in "$SESSIONS_DIR"/session-*.json; do
  [ ! -f "$f" ] && continue

  # Parse JSON with sed (no jq dependency)
  # Assumes pretty-printed JSON with one key per line, no escaped quotes in values.
  # This is safe because Claude writes these files in a predictable format.
  status=""
  updated=""
  skill=""
  project_name=""

  while IFS= read -r line; do
    case "$line" in
      *'"status":'*) status=$(echo "$line" | sed 's/.*: *"//;s/"[,]*$//');;
      *'"updated":'*) updated=$(echo "$line" | sed 's/.*: *"//;s/"[,]*$//');;
      *'"skill":'*) skill=$(echo "$line" | sed 's/.*: *"//;s/"[,]*$//');;
      *'"project_name":'*) project_name=$(echo "$line" | sed 's/.*: *"//;s/"[,]*$//');;
    esac
  done < "$f"

  [ "$status" != "active" ] && continue
  [ -z "$updated" ] && continue

  # Parse ISO timestamp — GNU date (available in Git Bash on Windows)
  updated_epoch=$(date -d "$updated" +%s 2>/dev/null || echo 0)
  age_seconds=$(( NOW - updated_epoch ))

  # 15-minute threshold to avoid false positives from long-running tasks
  # or users stepping away briefly with CLI still open
  [ "$age_seconds" -lt 900 ] && continue

  mins=$(( age_seconds / 60 ))
  STALE+="  $skill in $project_name (${mins}m ago)"$'\n'
done

# Also check for active-changes.log (v2 crash evidence)
LOG="$SESSIONS_DIR/active-changes.log"
if [ -f "$LOG" ]; then
  LOG_MTIME=$(stat -c %Y "$LOG" 2>/dev/null || date -r "$LOG" +%s 2>/dev/null || echo 0)
  log_age=$(( NOW - LOG_MTIME ))
  if [ "$log_age" -ge 900 ]; then
    log_mins=$(( log_age / 60 ))
    # Extract project name from SESSION header
    log_project=$(head -1 "$LOG" | sed -n 's/.*cwd=.*[/\\]\([^/\\]*\) .*/\1/p')
    [ -z "$log_project" ] && log_project="unknown"
    STALE+="  [from log] $log_project — file changes tracked, no clean exit (${log_mins}m ago)"$'\n'
  fi
fi

# Check for renamed crash logs too
for crash_log in "$SESSIONS_DIR"/active-changes-*.log; do
  [ ! -f "$crash_log" ] && continue
  crash_sid=$(basename "$crash_log" | sed 's/active-changes-//;s/\.log//')
  crash_project=$(head -1 "$crash_log" | sed -n 's/.*cwd=.*[/\\]\([^/\\]*\) .*/\1/p')
  [ -z "$crash_project" ] && crash_project="unknown"
  STALE+="  [from log] $crash_project — orphaned crash log ($crash_sid)"$'\n'
done

if [ -n "$STALE" ]; then
  echo "Stale sessions detected:"
  printf '%s' "$STALE"
  echo "Run /recover to resume or discard."
fi